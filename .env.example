# ==============================================================================
# EPA Punjab Social Listening & Environmental Intelligence Platform
# Template Environment Configuration (.env.example)
# Copy this file to '.env' and update with your custom credentials & secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8080
HOST=127.0.0.1
NODE_ENV=production
DB_PATH=data/epa_intelligence.db

# ------------------------------------------------------------------------------
# DEFAULT SYSTEM RBAC CREDENTIALS
# Used only when the users table is empty. Each password must be unique and
# at least 8 characters. Leave a password blank to have the server generate
# one and append it to data/bootstrap-credentials.txt (gitignored).
# Values containing CHANGE_ME, starting with YourSecure, or matching a
# previously published password are rejected and replaced the same way.
# ------------------------------------------------------------------------------

# 1. Super Administrator (Full clearance across all 20 system permissions)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@epa.punjab.gov.pk
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULLNAME=EPA Chief Administrator

# 2. Lead Environmental Analyst (Dashboards, analytics, post feeds, CSV/JSON export)
DEFAULT_ANALYST_USERNAME=analyst
DEFAULT_ANALYST_EMAIL=analyst@epa.punjab.gov.pk
DEFAULT_ANALYST_PASSWORD=
DEFAULT_ANALYST_FULLNAME=Dr. Ayesha Malik (Lead Analyst)

# 3. Field Auditor & Moderator (Audit ledger, noise moderation, rule learning)
DEFAULT_AUDITOR_USERNAME=auditor
DEFAULT_AUDITOR_EMAIL=auditor@epa.punjab.gov.pk
DEFAULT_AUDITOR_PASSWORD=
DEFAULT_AUDITOR_FULLNAME=Tariq Mehmood (Field Auditor)

# 4. Public Citizen / Observer (Read-only summary view)
DEFAULT_VIEWER_USERNAME=viewer
DEFAULT_VIEWER_EMAIL=viewer@epa.punjab.gov.pk
DEFAULT_VIEWER_PASSWORD=
DEFAULT_VIEWER_FULLNAME=Public Citizen / Observer

# ------------------------------------------------------------------------------
# X (TWITTER) DEVELOPER API CREDENTIALS
# Configure App-Only Bearer Token or Developer Consumer Keys to query live tweets.
# Leave the bearer blank to refuse live search. A missing token does not insert simulated posts.
# ------------------------------------------------------------------------------
DATA_SOURCE=file
X_BEARER_TOKEN=your_x_bearer_token_here
X_API_KEY=your_x_api_consumer_key_here
X_API_SECRET=your_x_api_consumer_secret_here
X_API_ENDPOINT=https://api.twitter.com/2/tweets/search/recent

# ------------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE CAPTCHA BOT PROTECTION
# Get keys from Cloudflare Dashboard -> Turnstile.
# The Cloudflare always-pass test site key and secret do not authenticate here.
# Leave both blank until real keys are set. Login then fails closed.
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# NLP & PIPELINE SETTINGS
# ------------------------------------------------------------------------------
SENTIMENT_ENGINE=vader
AUTO_ENRICH=true
